{
  "name": "bio103-fieldnotes",
  "version": "2.0.0",
  "description": "Study app for NSU BIO103: every lecture slide with an explanation, recall cards and exam-style practice.",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3103",
